DATABASE_URL=postgresql://postgres:password@localhost:5432/agent_guard
SECRET_KEY=super-secret-key-change-in-production-32chars
GROQ_API_KEY=gsk_...
NVIDIA_API_KEY=
# Set a current Nemotron model ID from https://build.nvidia.com
NVIDIA_MODEL=
OPENAI_API_KEY=sk-...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
ALLOW_ORIGINS=http://localhost:3000

# --- Meterless Nightshift (primary AI provider). Token: Nightshift's runtime token; on Windows it is read
# automatically from %LOCALAPPDATA%\ai.meterless.runtime\proxy-token when left empty. NVIDIA key goes in Nightshift's Providers tab.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# --- Zetaris (data layer): local install UI origin, org id and login. Then: python scripts/zetaris_setup.py
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=1
ZETARIS_USERNAME=admin@zetaris.com
ZETARIS_PASSWORD=your-zetaris-password
ZETARIS_SCHEMA=paywall
# SAMPLE_MODE=true: no Nightshift, Zetaris or network AI; labelled sample catalog + rules (H-MEM still runs locally)
SAMPLE_MODE=false
